local H = require("./harness")
local Setup = require("./setup")
local Resolve = require("../src/Resolve")

local describe, it, eq, truthy, throws = H.describe, H.it, H.eq, H.truthy, H.throws

describe("Resolve.parse", function()
	it("parses dotted paths with game. prefix", function()
		local a = assert(Resolve.parse("game.ReplicatedStorage.Remotes"))
		eq(a.kind, "path")
		eq(#a.segments, 2)
		eq(a.segments[1].name, "ReplicatedStorage")
		eq(a.all, false)
	end)
	it("parses quoted names", function()
		local a = assert(Resolve.parse("Workspace.'Blue Spawn'.Part"))
		eq(a.segments[2].name, "Blue Spawn")
		eq(a.segments[3].name, "Part")
	end)
	it("parses actors and roots", function()
		local a = assert(Resolve.parse("@p1"))
		eq(a.kind, "actor")
		eq(a.actor, "p1")
		eq(a.root, nil)
		local b = assert(Resolve.parse("@p1.character.HumanoidRootPart"))
		eq(b.root, "character")
		eq(b.segments[1].name, "HumanoidRootPart")
		local c = assert(Resolve.parse("@blue.gui.Menu.Spawn"))
		eq(c.root, "gui")
		eq(#c.segments, 2)
	end)
	it("rejects unknown actor roots", function()
		local a, err = Resolve.parse("@p1.HumanoidRootPart")
		eq(a, nil)
		truthy(err and err:find("actor root"), err)
	end)
	it("parses tags and vars with []", function()
		local t = assert(Resolve.parse("tag:Hostile[]"))
		eq(t.kind, "tag")
		eq(t.tag, "Hostile")
		eq(t.all, true)
		local v = assert(Resolve.parse("$target"))
		eq(v.kind, "var")
		eq(v.name, "target")
	end)
	it("parses wildcards and filters with typed literals", function()
		local a = assert(Resolve.parse("Workspace.*[@Team=Red,Health=100]"))
		local seg = a.segments[2]
		eq(seg.wild, "*")
		eq(#seg.filters, 2)
		eq(seg.filters[1].attr, true)
		eq(seg.filters[1].key, "Team")
		eq(seg.filters[1].value, "Red")
		eq(seg.filters[2].attr, false)
		eq(seg.filters[2].value, 100)
		local b = assert(Resolve.parse("Workspace.**.Spawn"))
		eq(b.segments[2].wild, "**")
		local c = assert(Resolve.parse("Workspace.X[Anchored=true]"))
		eq(c.segments[2].filters[1].value, true)
	end)
	it("reports syntax errors", function()
		eq((Resolve.parse("Workspace..Map")), nil)
		eq((Resolve.parse("Workspace.Map.")), nil)
		eq((Resolve.parse("Workspace.[]Map")), nil)
		eq((Resolve.parse("Workspace.Map[Name]")), nil)
		eq((Resolve.parse("")), nil)
	end)
end)

describe("Resolve.all against a stub DataModel", function()
	local game, w = Setup.world()
	local ctx = { vars = { target = "Workspace.Enemies.Boss", list = { "Workspace.Map", "Workspace.Enemies" } } }

	it("walks paths from game, with and without the game. prefix", function()
		eq(Resolve.one("Workspace.Map.Lamps", ctx), w.lamps)
		eq(Resolve.one("game.Workspace.Map", ctx), w.map)
		eq(Resolve.one("game", ctx), game)
		eq(Resolve.one("Workspace.Map.Spawns.'Red Spawn'", ctx).Name, "Red Spawn")
	end)
	it("falls back to GetService for the first segment", function()
		eq(Resolve.one("workspace.Map", ctx), w.map)
	end)
	it("returns first match without [] and all with []", function()
		local one = Resolve.all("Workspace.Map.Lamps.*", ctx)
		eq(#one, 1)
		eq(one[1].Name, "Lamp1")
		local all = Resolve.all("Workspace.Map.Lamps.*[]", ctx)
		eq(#all, 3)
		eq(all[3].Name, "Lamp3")
		eq(#Resolve.all("Workspace.Enemies.Grunt[]", ctx), 2)
	end)
	it("supports ** at any depth", function()
		local list = Resolve.all("Workspace.**.Spawn[]", ctx)
		eq(#list, 1)
		eq(list[1].Parent.Name, "Deep")
		local every = Resolve.all("Workspace.Map.**[]", ctx)
		eq(#every, 7) -- Lamps, Lamp1..3, Spawns, Blue, Red Spawn
	end)
	it("filters by property and attribute", function()
		eq(Resolve.one("Workspace.Enemies[Name=Boss]", ctx), w.boss)
		eq(#Resolve.all("Workspace.Enemies[@Team=Red][]", ctx), 2)
		eq(#Resolve.all("Workspace.**[@Health=100][]", ctx), 2)
		local red = Resolve.all("Workspace.Enemies.*[@Team=Red]", ctx)
		eq(#red, 1)
		local redAll = Resolve.all("Workspace.Enemies.*[@Team=Red][]", ctx)
		eq(#redAll, 2)
		local full = Resolve.all("Workspace.Enemies.*[@Team=Red,@Health=100][]", ctx)
		eq(#full, 1)
		eq(full[1], w.boss)
	end)
	it("resolves tags", function()
		local list = Resolve.all("tag:Hostile[]", ctx)
		eq(#list, 2)
		eq(#Resolve.all("tag:Hostile", ctx), 1)
	end)
	it("resolves vars (string, list)", function()
		eq(Resolve.one("$target", ctx), w.boss)
		local list = Resolve.all("$list", ctx)
		eq(#list, 2)
	end)
	it("resolves actors via ctx.playerFor", function()
		local Instance = require("@lune/roblox").Instance
		local player = Instance.new("Folder") -- stands in for a Player
		player.Name = "Player1"
		local char = Instance.new("Model")
		char.Name = "Player1"
		local root = Instance.new("Part")
		root.Name = "HumanoidRootPart"
		root.Parent = char
		local pg = Instance.new("Folder")
		pg.Name = "PlayerGui"
		pg.Parent = player
		local menu = Instance.new("Folder")
		menu.Name = "Menu"
		menu.Parent = pg
		player.Name = "Player1"
		local fake = setmetatable({}, {
			__index = function(_, k)
				if k == "Character" then
					return char
				elseif k == "FindFirstChildOfClass" then
					return function()
						return nil
					end
				elseif k == "FindFirstChild" then
					return function(_, n)
						return player:FindFirstChild(n)
					end
				end
				return (player :: any)[k]
			end,
		})
		local actx = {
			vars = {},
			playerFor = function(name)
				return if name == "p1" then fake else nil
			end,
		}
		eq(Resolve.one("@p1", actx), fake)
		eq(Resolve.one("@p1.character.HumanoidRootPart", actx), root)
		eq(Resolve.one("@p1.gui.Menu", actx), menu)
		throws(function()
			Resolve.one("@p2.character", actx)
		end, "RESOLVE_FAILED")
	end)
	it("raises RESOLVE_FAILED on zero matches unless allowEmpty", function()
		throws(function()
			Resolve.all("Workspace.Nope", ctx)
		end, "RESOLVE_FAILED")
		eq(#Resolve.all("Workspace.Nope", ctx, { allowEmpty = true }), 0)
		throws(function()
			Resolve.one("$missing", ctx)
		end, "RESOLVE_FAILED")
	end)
end)

describe("Value coercion", function()
	Setup.dataModel()
	local roblox = require("@lune/roblox")

	it("parses durations", function()
		eq(Resolve.duration("10s"), 10)
		eq(Resolve.duration("250ms"), 0.25)
		eq(Resolve.duration("1.5m"), 90)
		eq(Resolve.duration(3), 3)
		eq(Resolve.duration("2"), 2)
		eq((Resolve.duration("10 s")), nil)
		eq((Resolve.duration("abc")), nil)
		eq((Resolve.duration(-1)), nil)
	end)
	it("coerces generic values", function()
		local v = Resolve.coerceGeneric({ 1, 2, 3 })
		eq(typeof(v), "Vector3")
		eq(v, roblox.Vector3.new(1, 2, 3))
		local cf = Resolve.coerceGeneric({ pos = { 0, 5, 0 }, look = { 0, 0, -1 } })
		eq(typeof(cf), "CFrame")
		-- Lune's CFrame.lookAt flips the look axis; Studio does not. Check position + axis only.
		truthy((cf.Position - roblox.Vector3.new(0, 5, 0)).Magnitude < 1e-5)
		truthy(math.abs(math.abs(cf.LookVector.Z) - 1) < 1e-5)
		local c = Resolve.coerceGeneric("#ff8000")
		eq(typeof(c), "Color3")
		eq(math.floor(c.G * 255 + 0.5), 128)
		eq(Resolve.coerceGeneric("Enum.Material.Neon"), roblox.Enum.Material.Neon)
		eq(Resolve.coerceGeneric("Enum.Nope.Neon"), "Enum.Nope.Neon")
		eq(Resolve.coerceGeneric("hello"), "hello")
		eq(Resolve.coerceGeneric(4), 4)
		local list = Resolve.coerceGeneric({ 1, 2 })
		eq(typeof(list), "table")
	end)
	it("substitutes whole-value $vars only", function()
		local out = Resolve.substitute({ a = "$x", b = "pre $x", c = { "$x" }, d = "$nope" }, { x = 7 })
		eq(out.a, 7)
		eq(out.b, "pre $x")
		eq(out.c[1], 7)
		eq(out.d, "$nope")
	end)
	it("applies catalog params: defaults, coercion, validation", function()
		local Registry = require("../src/Registry")
		local reg = Registry.new("server")
		local near = reg:get("character.near").meta.params
		local p = Resolve.applyParams(near, { to = { 1, 2, 3 } }, {})
		eq(p.radius, 5)
		eq(typeof(p.to), "table") -- oneOf: resolved by the action
		local wait = reg:get("session.wait").meta.params
		eq(Resolve.applyParams(wait, { duration = "$d" }, { d = "500ms" }).duration, 0.5)
		throws(function()
			Resolve.applyParams(wait, {}, {})
		end, "BAD_PARAMS")
		throws(function()
			Resolve.applyParams(wait, { duration = "1s", extra = 1 }, {})
		end, "BAD_PARAMS")
		local count = reg:get("player.count").meta.params
		eq(Resolve.applyParams(count, { value = 2 }, {}).op, "eq")
		throws(function()
			Resolve.applyParams(count, { value = 2, op = "approx" }, {})
		end, "BAD_PARAMS")
		local click = reg:get("input.click").meta.params
		throws(function()
			Resolve.applyParams(click, {}, {})
		end, "BAD_PARAMS")
		eq(Resolve.applyParams(click, { position = { 10, 20 } }, {}).button, "Left")
		local setAttr = reg:get("instance.setAttribute").meta.params
		-- JSON null arrives as a missing key; allowed for untyped params
		local sp = Resolve.applyParams(setAttr, { target = "Workspace", name = "X" }, {})
		eq(sp.value, nil)
		local fire = reg:get("remote.fire").meta.params
		local fp = Resolve.applyParams(fire, { name = "RequestSpawn", args = { { 1, 2, 3 }, "x" } }, {})
		eq(typeof(fp.args[1]), "Vector3")
		eq(fp.args[2], "x")
	end)
	it("coerces for a property's current type", function()
		local game = Setup.dataModel()
		local part = roblox.Instance.new("Part")
		part.Parent = game:GetService("Workspace")
		eq(Resolve.coerceForProperty(part, "Material", "Neon", {}), roblox.Enum.Material.Neon)
		eq(Resolve.coerceForProperty(part, "Material", "Enum.Material.Wood", {}), roblox.Enum.Material.Wood)
		eq(typeof(Resolve.coerceForProperty(part, "Color", "#00ff00", {})), "Color3")
		eq(typeof(Resolve.coerceForProperty(part, "Size", { 4, 1, 2 }, {})), "Vector3")
	end)
end)
