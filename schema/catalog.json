  "dynamic": {
    "description": "Entries not in this file but valid at runtime. The daemon merges the live catalog (catalog command) over this file; unknown game.* names are only an error once a node has reported its catalog.",
    "game": {
      "source": "stagehand-hooks: Hooks.server{...} / Hooks.client{...} in the game",
      "nameTemplate": "game.<hookName>",
      "shape": {
        "name": "game.requestSpawn",
        "kind": "action",
        "contexts": [
          "server"
        ],
        "default": "server",
        "summary": "<hook desc>",
        "actor": "optional",
        "params": {
          "type": "object",
          "additionalProperties": true
        },
        "source": "hook"
      },
      "rules": [
        "contexts = [server] for Hooks.server, [client] for Hooks.client, both if registered on both (default server)",
        "kind = hook.kind or action",
        "condition hooks return a truthy/falsy value",
        "actor's Player is passed as the first argument (server) when `as` is set; params map is passed as the second argument"
      ]
    },
    "lua": {
      "description": "Pseudo-entry for the lua verb and for `wait: lua` / `expect: lua`.",
      "shape": {
        "name": "lua",
        "kind": "action | condition",
        "contexts": [
          "edit",
          "server",
          "client"
        ],
        "default": "server",
        "summary": "Run Luau in plugin identity with actor, player, character, vars in scope",
        "actor": "optional",
        "params": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            }
          },
          "required": [
            "code"
          ],
          "additionalProperties": false
        }
      }
    }
  }
